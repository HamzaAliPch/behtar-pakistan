/prisma/*.sqlite-wal
/prisma/*.sqlite-shm
/prisma/backups/
/private_uploads/
*.key
credentials*.txt
*tunnel-token*
*.secret

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
