DATABASE_URL="file:./dev.db"
# For cPanel production, use the private environment file documented in
# docs/namecheap-stellar-rc1.md. Never reuse this development DATABASE_URL.
# The production entrypoint sets BEHTAR_PRODUCTION=1 and requires an absolute
# SQLite DATABASE_URL plus absolute PRIVATE_UPLOAD_ROOT outside public_html.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
# Public Nominatim lookup is optional; the Karachi location catalog remains searchable without it.
GEOCODER_ENABLED="1"
GEOCODER_USER_AGENT="BehtarPakistan/1.0 (https://test.socialautomation.my.id)"
# Optional OpenAI-compatible endpoint. Leave unset for the local rules assistant.
# AI_PROVIDER_URL="http://127.0.0.1:11434/v1/chat/completions"
# AI_PROVIDER_MODEL="your-local-model"
# AI_PROVIDER_KEY=""
AI_DAILY_REQUEST_BUDGET=0
AI_REQUEST_TIMEOUT_MS=6000
# Optional admin-only reminder. Never published until a wallet is configured and verified.
DONATION_CANDIDATE_NUMBER=""
# Keep public payment collection disabled until an authorized owner has
# independently verified an appropriate receiving account and approved launch.
PUBLIC_DONATIONS_ENABLED="0"
PUBLIC_INDEXING_ENABLED="0"
# SMS and WhatsApp remain disabled. "smtp" enables transactional reset email only.
# "mock" works only when FRIEND_TEST_MODE=1 or AUTH_TEST_MODE=1 and never sends externally.
NOTIFICATION_PROVIDER_MODE="disabled"
NOTIFICATION_WORKER_ENABLED="0"
NOTIFICATION_WORKER_INTERVAL_MINUTES="5"
RESOLUTION_REMINDER_HOURS="24,72"
# Required HTTPS origin before any real provider adapter is enabled.
# NOTIFICATION_PUBLIC_ORIGIN="https://example.org"
NOTIFICATION_WEBHOOK_ENABLED="0"
# SMTP reset email requires production mode, NOTIFICATION_PROVIDER_MODE="smtp",
# all settings below, and an HTTPS reset-link origin. Set the real password only
# in the private production environment; never commit it or put it in this file.
# SMTP_HOST="mail.privateemail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="no-reply@behtarpakistan.org"
# SMTP_PASSWORD="SET_ONLY_IN_PRIVATE_PRODUCTION_ENVIRONMENT"
# SMTP_FROM="no-reply@behtarpakistan.org"
# SMTP_FROM_NAME="Behtar Pakistan"
# PASSWORD_RESET_PUBLIC_ORIGIN="https://behtarpakistan.org"
# Alternatively, the existing HTTPS relay accepts
# Authorization: Bearer <secret> and JSON {to,subject,text}; no reset links
# are displayed or logged. Friend/auth-test modes always disable live delivery.
# PASSWORD_RESET_DELIVERY_URL="https://your-approved-mail-relay.example/reset-email"
# PASSWORD_RESET_DELIVERY_SECRET="a-long-random-secret-at-least-32-characters"
# Configure a provider-specific signed webhook only after live integration approval.
# NOTIFICATION_WEBHOOK_SECRET=""
# Set to the approved production HTTPS origin only when indexing is authorized.
# PUBLIC_SITE_URL="https://example.org"
# Temporary friend testing is configured only by scripts/friend-test-env.ps1.
# Never point FRIEND_TEST_MODE at dev.db or private_uploads/.
